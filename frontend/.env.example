# Public, walletless simulation. This does not enable production game writes.
# Vite loads .env.local even for production builds; explicitly select this on hosts.
VITE_CHOG_ENV=production

# Optional public read-only Monad RPC override (chain 143).
# Never put a private API credential in VITE_*: these values are browser-visible.
# VITE_MONAD_RPC_URL=https://rpc.monad.xyz

# Local-only existing deployment. Copy to ignored .env.local and replace these
# public placeholders with verified local values. Never put these on a public host.
# VITE_CHOG_ENV=local
# VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
# VITE_LOCAL_CHOG_SURVIVOR_ADDRESS=<VERIFIED_LOCAL_GAME_ADDRESS>
# VITE_LOCAL_CHOG_SURVIVOR_DEPLOYMENT_BLOCK=<VERIFIED_DEPLOYMENT_BLOCK>

# No environment variable authorizes a production game deployment.
# VITE_CHOG_SURVIVOR_ADDRESS is not used by the current implementation.
