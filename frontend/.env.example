# Optional. Leave unset for clearly labelled Local Demo mode.
# This must be an independently reviewed, approved Monad-mainnet deployment address.
# VITE_CHOG_SURVIVOR_ADDRESS=

# Optional read-only RPC override. The public Monad RPC is used when unset.
# VITE_MONAD_RPC_URL=https://rpc.monad.xyz

# Local-only test mode. Never add these values to production hosting.
# It only starts when RPC is exactly localhost:8545 and the local game address is set.
# VITE_CHOG_ENV=local
# VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
# VITE_LOCAL_CHOG_SURVIVOR_ADDRESS=0x...
